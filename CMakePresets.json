{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ci",
      "inherits": "default",
      "cacheVariables": {
        "OMCPROXY_WERROR": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OMCPROXY_SANITIZE": "ON",
        "OMCPROXY_WERROR": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-fuzz",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_BUILD_TYPE": "Debug",
        "OMCPROXY_SANITIZE": "ON",
        "OMCPROXY_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "netns" } }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "netns" } }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "netns" } }
    },
    {
      "name": "netns",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "netns" } }
    },
    {
      "name": "netns-asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "netns" } }
    }
  ]
}
